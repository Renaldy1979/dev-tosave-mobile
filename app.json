      "output": "single",
      "favicon": "./assets/brand/favicon.png"
    },
    "extra": {
      "appwriteEndpoint": "https://tosave-appwrite.8m5sgi.easypanel.host/v1",
      "appwriteProjectId": "6aa1d3ab0039a9a9a8c4",
