{
  "name": "tosave-backend",
  "private": true,
  "type": "module",
  "description": "Schema como código, functions e migração do ToSave (Appwrite 1.8.1).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node --env-file=.env.local scripts/check-readonly.mjs",
    "probe-scopes": "node --env-file=.env.local scripts/probe-scopes.mjs",
    "inspect-source": "node --env-file=.env.local scripts/inspect-source.mjs",
    "survey-collections": "node --env-file=.env.local scripts/survey-collections.mjs",
    "schema": "node --env-file=.env.local scripts/schema.mjs",
    "deploy-functions": "node --env-file=.env.local scripts/deploy-functions.mjs",
    "migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "validate": "node --env-file=.env.local scripts/validate.mjs",
    "import-user": "node --env-file=.env.local scripts/import-user.mjs",
    "upload-images": "node --env-file=.env.local scripts/upload-images.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1138.0",
    "node-appwrite": "22.1.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "bcryptjs": "^3.0.3"
  }
}
